{
  "name": "@seed/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "echo 'no lint'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "pnpm --filter @seed/db test-db:reset && vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@seed/credits": "workspace:*",
    "@seed/db": "workspace:*",
    "@seed/provider-byteplus": "workspace:*",
    "@seed/provider-tochka": "workspace:*",
    "@seed/shared": "workspace:*",
    "@sentry/node": "^10.64.0",
    "bullmq": "5.79.3",
    "dotenv": "16.4.7",
    "drizzle-orm": "0.45.2",
    "ioredis": "5.10.1",
    "minio": "8.0.7",
    "nodemailer": "9.0.1",
    "pino": "9.5.0",
    "pino-pretty": "13.0.0",
    "prom-client": "15.1.3",
    "sharp": "0.33.5"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/nodemailer": "6.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
