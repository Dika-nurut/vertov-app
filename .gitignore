# nested git worktrees — `git add` records these as gitlinks (mode 160000) with no
# .gitmodules, which breaks a fresh clone. Keep worktrees OUT of the repo tree.
.worktrees/
.claude/worktrees/

# Alertmanager renders secrets to a host-local runtime file. The checked-in
# alertmanager.yml remains a placeholder/template only.
/infra/observability/*.rendered.yml
/infra/observability/.runtime/
